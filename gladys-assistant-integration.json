  "actions": [
    {
      "key": "test_sources",
      "label": {
        "en": "Test the sources",
        "fr": "Tester les sources",
        "de": "Quellen testen",
        "es": "Probar las fuentes"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "frequency_deviation",
      "label": {
        "en": "Frequency beyond the threshold",
        "fr": "Fréquence au-delà du seuil",
        "de": "Frequenz jenseits der Schwelle",
        "es": "Frecuencia más allá del umbral"
      },
      "description": {
        "en": "The frequency of a zone moves further from 50 Hz than the alert threshold of the configuration. Once per excursion.",
        "fr": "La fréquence d'une zone s'éloigne de 50 Hz au-delà du seuil d'alerte de la configuration. Une fois par écart.",
        "de": "Die Frequenz einer Zone entfernt sich weiter von 50 Hz als die Alarmschwelle der Konfiguration. Einmal pro Abweichung.",
        "es": "La frecuencia de una zona se aleja de 50 Hz más allá del umbral de alerta de la configuración. Una vez por desviación."
      },
