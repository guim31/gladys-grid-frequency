{
  "manifest_version": 1,
  "type": "device",
  "name": "Grid Frequency",
  "description": {
    "en": "Real-time frequency of the European power grids: continental, Nordic and Great Britain.",
    "fr": "Fréquence en temps réel des réseaux électriques européens : continental, nordique, britannique.",
    "de": "Echtzeit-Frequenz der europäischen Stromnetze: Kontinentaleuropa, Nordeuropa, Großbritannien.",
    "es": "Frecuencia en tiempo real de las redes eléctricas europeas: continental, nórdica y británica."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-grid-frequency:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-grid-frequency/main/cover.png",
  "categories": ["energy"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Open sources, no account",
        "fr": "Sources ouvertes, sans compte",
        "de": "Offene Quellen, ohne Konto",
        "es": "Fuentes abiertas, sin cuenta"
      },
      "description": {
        "en": "The frequency tells the balance between production and consumption, at 50 Hz in Europe. Read from netzfrequenzmessung.de and netzfrequenz.info (continental), Statnett (Nordic) and Elexon (Great Britain). Not affiliated with them.",
        "fr": "La fréquence dit l'équilibre entre production et consommation, à 50 Hz en Europe. Lue sur netzfrequenzmessung.de et netzfrequenz.info (continental), Statnett (nordique) et Elexon (britannique). Sans lien avec eux.",
        "de": "Die Frequenz zeigt das Gleichgewicht von Erzeugung und Verbrauch, in Europa 50 Hz. Gelesen bei netzfrequenzmessung.de und netzfrequenz.info (Kontinent), Statnett (Nordeuropa) und Elexon (Großbritannien). Nicht mit ihnen verbunden.",
        "es": "La frecuencia indica el equilibrio entre producción y consumo, 50 Hz en Europa. Leída en netzfrequenzmessung.de y netzfrequenz.info (continental), Statnett (nórdica) y Elexon (británica). Sin relación con ellos."
      },
      "links": [
        {
          "url": "https://www.netzfrequenzmessung.de",
          "label": {
            "en": "netzfrequenzmessung.de",
            "fr": "netzfrequenzmessung.de",
            "de": "netzfrequenzmessung.de",
            "es": "netzfrequenzmessung.de"
          }
        },
        {
          "url": "https://driftsdata.statnett.no",
          "label": {
            "en": "Statnett operational data",
            "fr": "Données d'exploitation Statnett",
            "de": "Betriebsdaten von Statnett",
            "es": "Datos operativos de Statnett"
          }
        },
        {
          "url": "https://bmrs.elexon.co.uk",
          "label": {
            "en": "Elexon BMRS",
            "fr": "Elexon BMRS",
            "de": "Elexon BMRS",
            "es": "Elexon BMRS"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the device and feature names (fixed when a device is added) and of the texts sent to scenes.",
        "fr": "Langue des noms d'appareils et de fonctionnalités (figés à l'ajout d'un appareil) et des textes envoyés aux scènes.",
        "de": "Sprache der Geräte- und Funktionsnamen (beim Hinzufügen festgelegt) und der Texte für Szenen.",
        "es": "Idioma de los nombres de dispositivos y funciones (fijados al añadir un dispositivo) y de los textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "continental",
      "type": "boolean",
      "label": {
        "en": "Continental Europe",
        "fr": "Europe continentale",
        "de": "Kontinentaleuropa",
        "es": "Europa continental"
      },
      "description": {
        "en": "From Portugal to Poland and Greece, France and Germany included: one device.",
        "fr": "Du Portugal à la Pologne et à la Grèce, France et Allemagne comprises : un appareil.",
        "de": "Von Portugal bis Polen und Griechenland, mit Frankreich und Deutschland: ein Gerät.",
        "es": "De Portugal a Polonia y Grecia, Francia y Alemania incluidas: un dispositivo."
      },
      "required": false,
      "default": true
    },
    {
      "key": "nordic",
      "type": "boolean",
      "label": {
        "en": "Nordic area",
        "fr": "Zone nordique",
        "de": "Nordeuropa",
        "es": "Zona nórdica"
      },
      "description": {
        "en": "Norway, Sweden, Finland and eastern Denmark: one device.",
        "fr": "Norvège, Suède, Finlande et est du Danemark : un appareil.",
        "de": "Norwegen, Schweden, Finnland und Ostdänemark: ein Gerät.",
        "es": "Noruega, Suecia, Finlandia y el este de Dinamarca: un dispositivo."
      },
      "required": false,
      "default": false
    },
    {
      "key": "gb",
      "type": "boolean",
      "label": {
        "en": "Great Britain",
        "fr": "Grande-Bretagne",
        "de": "Großbritannien",
        "es": "Gran Bretaña"
      },
      "description": {
        "en": "England, Scotland and Wales: one device. The values arrive about two minutes late.",
        "fr": "Angleterre, Écosse et pays de Galles : un appareil. Les valeurs arrivent avec environ deux minutes de retard.",
        "de": "England, Schottland und Wales: ein Gerät. Die Werte kommen etwa zwei Minuten verspätet.",
        "es": "Inglaterra, Escocia y Gales: un dispositivo. Los valores llegan con unos dos minutos de retraso."
      },
      "required": false,
      "default": false
    },
    {
      "key": "interval_seconds",
      "type": "select",
      "label": {
        "en": "Reading interval",
        "fr": "Intervalle de lecture",
        "de": "Leseintervall",
        "es": "Intervalo de lectura"
      },
      "description": {
        "en": "How often each zone is read. Every reading can change the states: 30 s is a good balance.",
        "fr": "Fréquence de lecture de chaque zone. Chaque lecture peut changer les états : 30 s est un bon compromis.",
        "de": "Wie oft jede Zone gelesen wird. Jede Lesung kann die Zustände ändern: 30 s ist ein guter Kompromiss.",
        "es": "Frecuencia de lectura de cada zona. Cada lectura puede cambiar los estados: 30 s es un buen equilibrio."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "10 s",
            "fr": "10 s",
            "de": "10 s",
            "es": "10 s"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 s",
            "fr": "15 s",
            "de": "15 s",
            "es": "15 s"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 s",
            "fr": "30 s",
            "de": "30 s",
            "es": "30 s"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 s",
            "fr": "60 s",
            "de": "60 s",
            "es": "60 s"
          }
        }
      ]
    },
    {
      "key": "alert_threshold_mhz",
      "type": "select",
      "label": {
        "en": "Alert threshold",
        "fr": "Seuil d'alerte",
        "de": "Alarmschwelle",
        "es": "Umbral de alerta"
      },
      "description": {
        "en": "Deviation from 50 Hz that fires the scene trigger. 100 mHz is rare on the continent, usual in Great Britain.",
        "fr": "Écart à 50 Hz qui déclenche les scènes. 100 mHz est rare sur le continent, courant en Grande-Bretagne.",
        "de": "Abweichung von 50 Hz, die die Szenen auslöst. 100 mHz ist auf dem Kontinent selten, in Großbritannien üblich.",
        "es": "Desviación de 50 Hz que activa las escenas. 100 mHz es raro en el continente, habitual en Gran Bretaña."
      },
      "required": false,
      "default": "100",
      "options": [
        {
          "value": "50",
          "label": {
            "en": "±50 mHz",
            "fr": "±50 mHz",
            "de": "±50 mHz",
            "es": "±50 mHz"
          }
        },
        {
          "value": "100",
          "label": {
            "en": "±100 mHz",
            "fr": "±100 mHz",
            "de": "±100 mHz",
            "es": "±100 mHz"
          }
        },
        {
          "value": "150",
          "label": {
            "en": "±150 mHz",
            "fr": "±150 mHz",
            "de": "±150 mHz",
            "es": "±150 mHz"
          }
        },
        {
          "value": "200",
          "label": {
            "en": "±200 mHz",
            "fr": "±200 mHz",
            "de": "±200 mHz",
            "es": "±200 mHz"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "±300 mHz",
            "fr": "±300 mHz",
            "de": "±300 mHz",
            "es": "±300 mHz"
